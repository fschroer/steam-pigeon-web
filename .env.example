# Copy to .env.local and fill from Firebase console -> Project settings ->
# General -> Your apps -> Web app -> SDK setup and configuration (Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=steam-pigeon.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=steam-pigeon
VITE_FIREBASE_STORAGE_BUCKET=steam-pigeon.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Optional: the in-page 3D view. A Google Maps Platform key for the Maps
# JavaScript API, restricted by HTTP referrer to this site (see the README).
# Leave empty to hide the 3D view.
VITE_GOOGLE_MAPS_API_KEY=
